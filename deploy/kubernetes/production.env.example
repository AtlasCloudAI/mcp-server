# ==============================================================================
# MCP Server 生产环境配置（权威清单）
#
# 这份文件列出 http 侧进程会读的每一个环境变量 —— 从 src/config.ts 的 zod
# schema 加上全仓 process.env / env.X 的实际读取点扫出来的，不是凭记忆列的。
# 共 47 项：必填 6、要填占位符 3、其余有默认值。
#
# 用法：这些值最终落在 deploy/kubernetes/production.example/ 的 Deployment env
# 里。本文件是「为什么是这个值」的说明，改配置时两边都要改。
#
#   REQUIRED  进程启动就要，缺了起不来
#   FILL      必须填，值要别人给
#   DEFAULT   不设也行，写出来是为了说明它的存在
#   SECRET    走 K8s Secret，不要写进 YAML
#   NEVER     绝对不要设，理由见注释
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 运行档位与进程
# ------------------------------------------------------------------------------

# REQUIRED  production 会打开一批硬性校验：必须 HTTPS、必须 Redis 幂等、
#           必须有确认密钥、拒绝对称签名算法。
NODE_ENV=production

# REQUIRED  发布档位。production 额外要求：非 dev/staging 主机名、
#           凭据模式必须是 oauth-exchange 或 redis-subject-map、Redis URL 带密码。
#           service-account（一把共享 key）和 subject-map（env 里的静态映射）
#           会把账单记到错误的人头上，所以这两个在 production 下被按名字拒掉。
PLUGIN_RELEASE_TIER=production

# DEFAULT   HOST 默认 127.0.0.1，容器里必须改成 0.0.0.0，否则 Service 连不进来。
HOST=0.0.0.0

# DEFAULT   3000。Service 的 targetPort 指向名为 http 的这个端口。
#           Dockerfile 写 EXPOSE 3000 3001，3001 是自建授权页（不部署）的端口。
PORT=3000


# ------------------------------------------------------------------------------
# 2. 本服务的对外身份
#
# 下面三个值必须互相一致，而且 AUDIENCE 要和生产授权服务器里登记的资源标识
# 逐字符相同 —— 差一个斜杠的表现是每个请求都 401。
# ------------------------------------------------------------------------------

# REQUIRED
MCP_PUBLIC_URL=https://mcp.atlascloud.ai/mcp

# DEFAULT   不设则跟随 MCP_PUBLIC_URL。显式写出来，因为它是最容易配错的一项。
MCP_OAUTH_AUDIENCE=https://mcp.atlascloud.ai/mcp

# DEFAULT   不设则用 MCP_PUBLIC_URL 的主机名 + 回环地址。精确匹配，不支持通配。
#           探针也必须带上这里的 Host，否则会被它拦掉，表现为 Pod 一直不就绪。
MCP_ALLOWED_HOSTS=mcp.atlascloud.ai

# DEFAULT   这三个源是 ChatGPT / Codex 侧发起请求时会带的 Origin。
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://platform.openai.com

# DEFAULT   0。在 ingress 后面必须是 1，否则限流看到的都是网关 IP，
#           一个用户就能把所有人的额度打满。
MCP_TRUST_PROXY=1

# DEFAULT   可选，填了会写进资源元数据供客户端展示。
# MCP_RESOURCE_DOCUMENTATION=


# ------------------------------------------------------------------------------
# 3. 授权服务器
#
# 这几个值已用 https://auth.atlascloud.ai/.well-known/oauth-authorization-server
# 核对过：端点都在【根路径】，不是 /api/v1/oidc/*。
#
# 启动自检会拿 JWKS_URI 和这份元数据对账，写错则 Pod 永远不就绪 —— 这是
# fail-closed，宁可不就绪也不要在配置错的情况下放行请求。
# ------------------------------------------------------------------------------

# REQUIRED
MCP_OAUTH_ISSUER=https://auth.atlascloud.ai

# REQUIRED
MCP_OAUTH_JWKS_URI=https://auth.atlascloud.ai/jwks

# DEFAULT   发现到的端点只允许落在这些主机上。防的是「元数据被改 → 去别处取
#           JWKS → 接受伪造令牌」。不设则从 issuer 推导。
MCP_OAUTH_ENDPOINT_HOSTS=auth.atlascloud.ai

# DEFAULT   RS256,ES256。生产会拒绝 HS256 这类对称算法和 none：
#           对称算法意味着任何拿到验签密钥的人都能签发令牌。
MCP_OAUTH_ALGORITHMS=RS256

# DEFAULT   30 秒。容忍两端时钟偏差。
# MCP_OAUTH_CLOCK_TOLERANCE_SECONDS=30

# DEFAULT   不设则用平台完整 scope 集。只能填平台已定义的 scope，填别的启动即报错。
# MCP_OAUTH_SCOPES=
# MCP_ADVERTISED_SCOPES=


# ------------------------------------------------------------------------------
# 4. 凭据模式：令牌交换（RFC 8693）
#
# 服务端不保存任何用户 API key。每个请求把调用者自己的 OAuth 令牌换成一枚
# 面向模型 API 的令牌，所以生成费用记在调用者自己账户上。
#
# 换来的令牌只存在【进程内存】的一个 Map 里（src/services/token-exchange.ts），
# 不落 Redis、不落磁盘。
#
# 下面四项在这个模式下【缺一不可】，缺了就在加载配置时报错。刻意不静默降级 ——
# 降级的后果是「以为不用贴 key、实际每个人还在贴」长期没人发现。
# ------------------------------------------------------------------------------

# REQUIRED
MCP_CREDENTIAL_MODE=oauth-exchange

# REQUIRED
MCP_TOKEN_EXCHANGE_URL=https://auth.atlascloud.ai/token

# REQUIRED  换出来的令牌面向哪个资源。
MCP_TOKEN_EXCHANGE_RESOURCE=https://api.atlascloud.ai

# FILL      由生产授权服务器管理员登记 token-exchange 保密客户端后提供。
MCP_TOKEN_EXCHANGE_CLIENT_ID=REPLACE_WITH_PRODUCTION_CLIENT_ID

# SECRET    同上，登记当时产生的【明文】secret。
#           授权服务器库里只存 bcrypt 哈希，事后取不出来 —— 登记当时不记下就没了。
#           来自 Secret：atlas-mcp-token-exchange / client-secret
MCP_TOKEN_EXCHANGE_CLIENT_SECRET=

# DEFAULT   交换时请求的 scope。两端词表不一致会报 invalid_scope。
# MCP_TOKEN_EXCHANGE_SCOPE=


# ------------------------------------------------------------------------------
# 5. 上游 Atlas API
#
# 生产是一个网关后面两个上游，按路径分工：
#   /api/v1/models · /model/uploadMedia · /public/v1/*        → kubedl backend
#   /api/v1/model/{generateImage,generateVideo,generateAudio}
#   /api/v1/model/prediction/:id · /api/v1/model/calculate
#   /v1/*（chat completions）                                 → aiproxy
#
# 已实测：单 origin https://api.atlascloud.ai 覆盖全部 7 条路径。
#
# 同集群内直连 Service 时这两个上游是两个不同地址，单 origin 表达不了 ——
# 指错了会拿到 404，而 404 在错误映射里长得像「参数不对」，排查会绕远路。
# ------------------------------------------------------------------------------

# FILL      生产 backend。拿不到内网地址就填 https://api.atlascloud.ai
#           必须是裸 origin，不能带路径 —— 带了会拼成 /api/v1/api/v1/...
ATLASCLOUD_API_BASE_URL=REPLACE_WITH_BACKEND_BASE_URL

# FILL      生产 aiproxy。同上。
ATLASCLOUD_GENERATION_API_BASE_URL=REPLACE_WITH_AIPROXY_BASE_URL


# ------------------------------------------------------------------------------
# 6. Redis 与幂等
#
# Redis 只承担一件事：防重复扣费。每个生成调用都包在幂等键里，三个状态 ——
# pending（正在进行，拒第二次）、completed（返回上次结果，不再跑）、
# uncertain（上次没拿到确认响应，报错让用户查账单而不是默默再跑一次）。
#
# 里面【没有任何用户凭据】，所以不需要专用实例，共用或托管 Redis 都行。
# ------------------------------------------------------------------------------

# REQUIRED  production 下必须是 redis。内存态在 pod 重启时全丢、多副本时各自
#           一份互不相认 —— 在计费路径上静默失效是最糟的失败方式。
MCP_IDEMPOTENCY_BACKEND=redis

# SECRET    redis://:密码@主机:6379
#           production 档位【强制带密码】，无密码直接拒绝启动。
#           来自 Secret：atlascloud-openai-plugin / redis-url
MCP_REDIS_URL=

# DEFAULT   86400 秒。幂等键保留多久。
# MCP_IDEMPOTENCY_TTL_SECONDS=86400

# SECRET    至少 32 字节随机值。$20 以上的生成会先报价再确认，确认令牌是
#           无状态 HMAC（不存 Redis），所以【每个副本必须共享同一个值】，
#           否则一个副本发的报价在另一个副本上验不过。
#           来自 Secret：atlascloud-openai-plugin / generation-confirmation-secret
MCP_GENERATION_CONFIRMATION_SECRET=

# DEFAULT   600 秒。报价的有效期。
# MCP_GENERATION_CONFIRMATION_TTL_SECONDS=600

# DEFAULT   仅 redis-subject-map 模式用来给 Redis 里的凭据加前缀。
#           oauth-exchange 下不存凭据，这项没有作用。
# MCP_CREDENTIAL_REDIS_PREFIX=atlascloud:openai-plugin:credential


# ------------------------------------------------------------------------------
# 7. 限流
# ------------------------------------------------------------------------------

# DEFAULT   120/分钟。鉴权【之前】按 IP 限流。依赖 MCP_TRUST_PROXY=1 才能拿到真实 IP。
# MCP_PREAUTH_REQUESTS_PER_MINUTE=120

# DEFAULT   60/分钟。鉴权【之后】按 OAuth subject 限流。
# MCP_SUBJECT_REQUESTS_PER_MINUTE=60


# ------------------------------------------------------------------------------
# 8. 自动提交阈值
# ------------------------------------------------------------------------------

# DEFAULT   20（美元）。低于这个报价的生成直接提交，不打断用户；
#           高于或拿不到报价则先返回价格等确认 —— fail-closed。
#           设成 0 或写成非法值 = 每次都要确认。
# MCP_AUTOSUBMIT_MAX_USD=20


# ------------------------------------------------------------------------------
# 9. 图片预览与外部抓取
#
# 服务端把产出图抓回来转成 base64，让图能显示在对话里（MCP 协议不支持视频块，
# 所以视频只给链接）。这条链路是 fail-open：抓不到只掉预览，不影响出片。
#
# 下面两个主机白名单是 SSRF 闸门：不在名单里的地址直接拒绝抓取。
# 开头带点表示后缀匹配（不同环境的 bucket 主机名不一样）。
# ------------------------------------------------------------------------------

# DEFAULT   true
# MCP_MEDIA_PREVIEW_ENABLED=true

# DEFAULT   .aliyuncs.com,.atlascloud.ai —— 产出图允许从哪些主机抓
# MCP_MEDIA_PREVIEW_HOSTS=.aliyuncs.com,.atlascloud.ai

# DEFAULT   4。一次最多回传几张预览。
# MCP_MEDIA_PREVIEW_MAX=4

# DEFAULT   1024。抓取时按这个长边做服务端缩放，控制 base64 体积。
# MCP_MEDIA_PREVIEW_EDGE=1024

# DEFAULT   static.atlascloud.ai —— 拉模型 schema 和文档的白名单
# ATLASCLOUD_EXTERNAL_RESOURCE_HOSTS=static.atlascloud.ai


# ------------------------------------------------------------------------------
# 10. 上传
# ------------------------------------------------------------------------------

# DEFAULT   限制本地文件上传的根目录。远端部署本来就不该读本地文件，留空即可。
# ATLASCLOUD_UPLOAD_ROOTS=

# DEFAULT   单文件上传上限。
# ATLASCLOUD_MAX_UPLOAD_BYTES=


# ------------------------------------------------------------------------------
# 11. OpenAI 插件门户
# ------------------------------------------------------------------------------

# SECRET    门户校验用的 challenge token。
#           来自 Secret：atlascloud-openai-plugin / openai-challenge-token
OPENAI_APPS_CHALLENGE_TOKEN=


# ==============================================================================
# 绝对不要设的
# ==============================================================================

# NEVER  ⚠️ api-client.ts 在模块加载时就会从这两个变量建一个 proxy dispatcher，
#        然后【所有上游调用都走它】—— 包括带着换来的 bearer 令牌那些。
#        一旦 pod 环境里出现它们（比如从集群级配置继承、或为出网而设），
#        用户令牌就会流经那个中转，而且不会有任何日志提示。
#        规定：token 相关调用不经过中转代理。
#
#        大小写都要避免：https_proxy / HTTPS_PROXY / http_proxy / HTTP_PROXY
#
# HTTP_PROXY=
# HTTPS_PROXY=

# NEVER  一把共享的服务账号 key。设了它并把 MCP_CREDENTIAL_MODE 改成
#        service-account，就是把所有人的生成都记到同一个账户上 ——
#        整个「按调用者计费」的设计就没了。production 档位会拒绝这个模式，
#        但这个变量本身不该出现在生产环境里。
# ATLASCLOUD_API_KEY=


# ==============================================================================
# 旧架构遗留（不要设）
#
# 这几项属于「服务端保存加密后的用户 key」那一代（redis-subject-map）。
# 现在换来的令牌只在进程内存，服务端不存任何凭据，所以：
# ==============================================================================

# oauth-exchange 模式下代码根本不会读到这个钥匙串 ——
# createConfiguredCredentialResolver 在建 store 之前就 return 了。
# production.example/ 的 overlay 用 $patch: delete 显式删掉了它。
# MCP_CREDENTIAL_ENCRYPTION_KEYS_JSON=

# 写死在 env 里的「OAuth subject → Atlas key」静态映射。同样已被删掉。
# MCP_ATLAS_SUBJECT_KEYS_JSON=
