{
  "name": "atlascloud-mcp",
  "version": "2.1.0",
  "description": "Secure local and remote MCP server for Atlas Cloud AI media generation, model discovery, prediction status, and billing data.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "atlascloud-mcp": "dist/index.js",
    "atlascloud-mcp-http": "dist/http.js",
    "atlascloud-mcp-auth": "dist/auth.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "start:auth": "node dist/auth.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "dev:auth": "tsx watch src/auth.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "tsx --test test/**/*.test.ts",
    "test:codex-oauth": "./scripts/test-codex-oauth-app-server-login.sh",
    "test:coverage": "tsx --test --experimental-test-coverage test/**/*.test.ts",
    "validate:production-config": "npm run build && node scripts/validate-production-config.mjs",
    "check": "npm run build && npm test && npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "atlascloud",
    "atlas-cloud",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "cline",
    "ai-video-generation",
    "text-to-image",
    "text-to-speech",
    "tts",
    "image-to-3d",
    "llm",
    "image-generation",
    "video-generation",
    "audio-generation",
    "3d-generation",
    "music-generation",
    "speech-to-text",
    "asr",
    "transcription"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "jose": "6.2.8",
    "oidc-provider": "9.11.3",
    "redis": "5.8.2",
    "undici": "7.29.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "body-parser": "2.3.0",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.5",
    "hono": "4.13.1",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.3"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "^22.10.0",
    "@types/oidc-provider": "9.11.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
